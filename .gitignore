# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Raw source PDFs — large (~780MB), regenerated by scripts/fetch-pdfs.mjs.
# But the per-page OCR caches are tiny (~5MB) and we DO commit them so
# CI can rebuild the search index, live-feed, work-available, dossier
# extracts etc. dynamically on every push. The PDF binaries stay ignored.
data-raw/*
!data-raw/.vision-cache/
!data-raw/.ocr-cache/
!data-raw/.visuals/
!data-raw/.contributions-manifest.json
!data-raw/corpus.sqlite
# Canonical source-of-truth CSV from war.gov/UFO — pulled via whipgen_web_eval.
# Committed so volunteers can ingest without rerunning the scrape.
!data-raw/uap-data.csv
# upstream-gemini is a clone of DenisSergeevitch/UFO-USA — the imported
# transcripts live in .vision-cache/, so the upstream clone itself only
# needs to exist on the maintainer's box for refreshes.
data-raw/upstream-gemini/

# tesseract.js downloads the trained data on first run
eng.traineddata
*.traineddata

# Claude Code harness scratch — sub-agent worktrees are isolated copies of
# the repo and don't belong in version control.
.claude/worktrees/

# Release-01 PDFs are served at runtime from war.gov directly (see
# src/data/events.js URL_BASE), so the committed copies were pure
# processing-pipeline scratch — kept on disk locally for FAISS/dossier/
# visuals extraction but not needed in the deploy or in git. Release-02
# PDFs stay committed because the deploy serves them from public/release_2/.
public/release_1/*.pdf
# Same logic for any video/audio assets — they're processed locally for
# frames/transcripts but don't ship in the bundle.
public/**/*.mp4
public/**/*.mov
public/**/*.webm
public/**/*.avi
public/**/*.mkv

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
