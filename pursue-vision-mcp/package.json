{
  "name": "pursue-vision-mcp",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Minimal daemon that drives an already-logged-in ChatGPT browser tab to OCR pages of documents. Drop-in compatible with the pursue-console vision-OCR pipeline.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node start.mjs",
    "daemon": "node daemon.mjs",
    "status": "node -e \"const t=require('fs').readFileSync(require('os').homedir()+'/.pursue-vision-token','utf8').trim(); fetch('http://127.0.0.1:9223/status',{headers:{Authorization:'Bearer '+t}}).then(r=>r.text()).then(console.log)\""
  },
  "dependencies": {
    "playwright": "^1.50.0"
  }
}
