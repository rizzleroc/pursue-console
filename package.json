{
  "name": "pursue-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-search-index.mjs && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages -t true",
    "corpus:fetch": "node scripts/fetch-pdfs.mjs",
    "corpus:extract": "node scripts/extract-text.mjs",
    "corpus:ocr": "node scripts/ocr-scanned.mjs",
    "corpus": "npm run corpus:fetch && npm run corpus:extract"
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "pdfjs-dist": "^5.7.284",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tesseract.js": "^7.0.0",
    "vite": "^8.0.10"
  }
}
