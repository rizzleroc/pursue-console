    "corpus:sync": "node scripts/sync-inventory.mjs",
    "corpus:review": "node scripts/export-review-queue.mjs",
    "corpus:import": "node scripts/import-contributions.mjs",
    "corpus:import:gemini": "node scripts/import-gemini-corpus.mjs",
    "corpus:catalogue:auto": "node scripts/auto-catalogue-from-gemini.mjs",
    "corpus:compare": "node scripts/compare-sources.mjs",
    "corpus:reeval": "node scripts/reevaluate-disputed.mjs",
    "corpus:judge": "node scripts/judge-disputed.mjs",
    "corpus:classify": "node scripts/classify-visuals.mjs",
    "corpus:extract-media": "node scripts/extract-media-from-gemini.mjs",
    "corpus:media": "node scripts/build-media-index.mjs",
    "corpus:coverage": "node scripts/diagnose-coverage.mjs",
    "corpus:alignment": "node scripts/diagnose-page-alignment.mjs",
    "corpus:sync-check": "node scripts/diagnose-deploy-sync.mjs",
    "corpus:contributors": "node scripts/build-contributors.mjs",
    "corpus:transcribe": "node scripts/transcribe-gemini-api.mjs",
    "corpus:fetch-missing": "node scripts/fetch-missing-pdfs.mjs",
    "corpus:setup": "node scripts/setup-volunteer.mjs",
    "corpus:unverified": "node scripts/find-unverified.mjs",
    "corpus:import-candidates": "node scripts/detect-import-candidates.mjs",
    "corpus:fetch-release-2": "node scripts/fetch-release-2.mjs",
    "test:parse-template": "node scripts/test-parse-template.mjs",
    "corpus:migrate-per-source": "node scripts/migrate-per-source-text.mjs",
    "corpus:db": "node scripts/db-rebuild.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages -t true",
    "corpus:fetch": "node scripts/fetch-pdfs.mjs",
    "corpus:extract": "node scripts/extract-text.mjs",
    "corpus:ocr": "node scripts/ocr-scanned.mjs",
    "corpus:vision": "node scripts/vision-ocr.mjs",
    "corpus:visuals": "node scripts/vision-visuals-augment.mjs",
    "corpus:feed": "node scripts/build-live-feed.mjs",
    "corpus:embed": "python scripts/build-embeddings.py",
    "corpus:similarity": "node scripts/build-event-similarity.mjs",
    "corpus:extracts": "node scripts/build-dossier-extracts.mjs",
    "corpus:texts": "node scripts/build-text-files.mjs",
    "corpus": "npm run corpus:fetch && npm run corpus:extract",
    "corpus:patterns": "node scripts/build-patterns.mjs",
    "corpus:gc-claims": "node scripts/gc-claims.mjs",
    "corpus:workqueue": "node scripts/build-work-available.mjs",
    "corpus:version": "node scripts/build-corpus-version.mjs",
    "corpus:rebuild": "npm run corpus:texts && npm run corpus:embed && npm run corpus:similarity && npm run corpus:extracts && npm run corpus:patterns && npm run corpus:workqueue && npm run corpus:feed && npm run corpus:version",
    "volunteer": "node scripts/volunteer.mjs",
    "volunteer:media": "node scripts/volunteer-media.mjs",
    "contrib:validate": "node scripts/validate-contribution.mjs",
    "contrib:validate:semantic": "python scripts/validate-contribution-semantic.py",
    "contrib:validate:all": "npm run contrib:validate && npm run contrib:validate:semantic"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.10.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tesseract.js": "^7.0.0",
    "vite": "^8.0.10"
  }
}
