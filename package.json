{
  "name": "pursue-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-ort-assets.mjs && node scripts/import-gemini-corpus.mjs && node scripts/import-contributions.mjs && node scripts/compare-sources.mjs && node scripts/build-text-files.mjs && node scripts/db-rebuild.mjs && node scripts/build-search-index.mjs && node scripts/build-live-feed.mjs && node scripts/build-event-similarity.mjs && node scripts/build-dossier-extracts.mjs && node scripts/build-patterns.mjs && node scripts/build-work-available.mjs && node scripts/build-corpus-version.mjs && vite build",
    "corpus:import": "node scripts/import-contributions.mjs",
    "corpus:import:gemini": "node scripts/import-gemini-corpus.mjs",
    "corpus:catalogue:auto": "node scripts/auto-catalogue-from-gemini.mjs",
    "corpus:compare": "node scripts/compare-sources.mjs",
    "corpus:migrate-per-source": "node scripts/migrate-per-source-text.mjs",
    "corpus:db": "node scripts/db-rebuild.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -b gh-pages -t true",
    "corpus:fetch": "node scripts/fetch-pdfs.mjs",
    "corpus:extract": "node scripts/extract-text.mjs",
    "corpus:ocr": "node scripts/ocr-scanned.mjs",
    "corpus:vision": "node scripts/vision-ocr.mjs",
    "corpus:visuals": "node scripts/vision-visuals-augment.mjs",
    "corpus:feed": "node scripts/build-live-feed.mjs",
    "corpus:embed": "python scripts/build-embeddings.py",
    "corpus:similarity": "node scripts/build-event-similarity.mjs",
    "corpus:extracts": "node scripts/build-dossier-extracts.mjs",
    "corpus:texts": "node scripts/build-text-files.mjs",
    "corpus": "npm run corpus:fetch && npm run corpus:extract",
    "corpus:patterns": "node scripts/build-patterns.mjs",
    "corpus:workqueue": "node scripts/build-work-available.mjs",
    "corpus:version": "node scripts/build-corpus-version.mjs",
    "corpus:rebuild": "npm run corpus:texts && npm run corpus:embed && npm run corpus:similarity && npm run corpus:extracts && npm run corpus:patterns && npm run corpus:workqueue && npm run corpus:feed && npm run corpus:version",
    "volunteer": "node scripts/volunteer.mjs",
    "contrib:validate": "node scripts/validate-contribution.mjs",
    "contrib:validate:semantic": "python scripts/validate-contribution-semantic.py",
    "contrib:validate:all": "npm run contrib:validate && npm run contrib:validate:semantic"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.10.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tesseract.js": "^7.0.0",
    "vite": "^8.0.10"
  }
}
